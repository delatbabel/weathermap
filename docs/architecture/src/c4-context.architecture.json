      "label": "names and world outline",
      "variant": "dashed"
    },
    {
      "id": "writes",
      "from": "weathermap",
      "to": "disk",
      "label": "writes PNG, reads preferences",
      "labelAt": [
        505,
        436
      ]
    },
    {
      "id": "posts",
      "from": "weathermap",
      "to": "instagram",
      "label": "posts a carousel",
      "variant": "dashed",
      "fromSide": "left",
      "toSide": "top"
    },
    {
      "id": "writes-charts",
      "from": "weathermap",
      "to": "objectstore",
      "label": "writes charts",
      "fromSide": "bottom",
      "toSide": "right"
    },
    {
      "id": "fetches",
      "from": "instagram",
      "to": "objectstore",
      "label": "fetches every image",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "What it is for",
      "items": [
        "Composites NOAA forecast fields over an OSM base map",
        "Wind barbs on top; the chart is read for the wind"
      ]
    },
    {
      "dot": "emerald",
      "title": "External dependencies",
      "items": [
        "NOMADS serves GRIB2 already cut to the area",
        "Overpass serves coastline, boundaries and place names",
        "Natural Earth ships in the jar and needs no network",
        "Instagram fetches images; it never accepts an upload",
        "So charts are written to an object store with a public URL"
      ]
    },
    {
      "dot": "rose",
      "title": "Fail-soft boundaries",
      "items": [
        "No Overpass answer still renders, from the bundle",
        "A run that has rolled off the archive is skipped, not fatal"
      ]
    }
  ]
}
