  "connections": [
    {
      "id": "picks",
      "from": "navigator",
      "to": "weathermap",
      "label": "chooses area and fields",
      "variant": "emphasis"
    },
    {
      "id": "grib",
      "from": "weathermap",
      "to": "nomads",
      "label": "HTTPS filter_gfs subsets",
      "fromSide": "top",
      "toSide": "left"
    },
    {
