target/
*.class
*.part

# Downloaded and generated data. Composited maps normally go outside the repo
# (~/.weathermap/maps by default), but not when --out points here.
maps/
*.grib2
*.osm.xml

# Archify's interactive viewers: ~800 KB each, regenerable from docs/architecture/src,
# and GitLab renders neither their JavaScript nor their inline styles. What the
# repository keeps is the source JSON and the exported SVG and Markdown.
docs/architecture/html/

# Cross-build toolchain fetched by `make bootstrap`: per-platform JDKs, Launch4j,
# cmake and libdmg-hfsplus. Hundreds of megabytes, all reproducible.
dist/jdks/
dist/tools/

# Built packages
tmp/

# IDE
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# Maven wrapper keeps its properties but not a downloaded distribution
.mvn/wrapper/maven-wrapper.jar
