# Mounts the Cloudflare R2 bucket that Instagram fetches chart images from.
#
# Modelled on the Nextcloud WebDAV mount this machine already runs, with the
# tuning where rclone actually reads it.
#
# THE FLAGS GO HERE, NOT IN rclone.conf. A remote stanza in rclone.conf holds
# *backend* options - for webdav that is url, vendor, user, pass. VFS and mount
# settings such as vfs-cache-mode, buffer_size, transfers and checkers are
# global flags, and rclone stores unrecognised keys in a stanza without
# complaining: a deliberately invented option is accepted just as quietly. So a
# tuning block written into the config file looks applied and is not.
#
# --vfs-cache-mode writes
#     Not optional here. Without it rclone must know a file length before it can
#     begin uploading, so an encoder that seeks back to write a header fails.
#     With it the file is written locally and uploaded once closed.
#
# --dir-cache-time 10s
#     Deliberately short, and the opposite of what a backup mount wants. Nothing
#     else writes to this bucket, and a chart should appear in a listing at once.
#
# --buffer-size 16M
#     Charts are hundreds of kilobytes. A large read-ahead buffer is for large
#     sequential files and only costs memory here.
#
# --vfs-write-back 1s
#     The default is five seconds, and it is a fixed wait per file rather than a
#     throughput limit - a closed file simply sits in the queue before the
#     upload starts. Writing eight charts that way looks like a slow mount and
#     is nothing of the sort. Nothing else writes to this bucket and the files
#     are small, so there is no batching to preserve.
#
# --transfers 4
#     One carousel is up to ten images, all independent.
#
# TWO BACKEND OPTIONS THIS MOUNT DEPENDS ON, both set in rclone.conf because
# they are backend options rather than mount flags:
#
#   no_check_bucket = true
#     Before its first write rclone checks the bucket exists, which is an
#     account-level call. A token scoped to one bucket cannot make it, so the
#     check fails with 403 AccessDenied and the write never starts. The 403
#     names no operation, so it reads exactly like a read-only token - which is
#     what it was first diagnosed as, wrongly, after the token had already been
#     recreated once with the right permissions.
#
#   no_head = true
#     R2 answers a PUT with an X-Amz-Version-Id header. rclone takes that as a
#     versioned bucket and re-reads the object by version id to verify what it
#     just uploaded - and R2 does not implement versioning, so that HEAD returns
#     501 NotImplemented. The upload has already succeeded at that point: the
#     object is in the bucket and rclone reports the transfer as failed anyway.
#     Skipping the verifying HEAD costs the post-upload integrity check; the
#     ETag in the PUT response is still checked against what was sent.
#
# rclone lives at /usr/local/bin, not /usr/bin. Deleting a file through a mount
# served by the distribution's rclone fails with EIO - it sends R2 the version
# ID from the write, and R2 has no versioned delete - which is fixed upstream.
# The distribution package is left in place for the other mounts on this
# machine; /usr/local/bin simply comes first.
#
# Install:
#   mkdir -p ~/weathermap-charts.saigonweather.online
#   sudo cp dist/r2/rclone-weathermap-r2.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rclone-weathermap-r2.service
#
[Unit]
Description=RClone mount for the Weather Map chart bucket (Cloudflare R2)
Documentation=man:rclone(1)
After=network-online.target
Wants=network-online.target

# No AssertPathIsDirectory here, deliberately. If the rclone process dies
# without unmounting, the FUSE mount survives it: /proc/mounts still lists the
# path and every stat of it returns ENOTCONN. The assertion is evaluated before
# ExecStartPre runs, so it fails on exactly the stale mount that a restart is
# meant to clear - "Assertion failed on job for rclone-weathermap-r2.service",
# with no way out of it but a manual fusermount. The ExecStartPre pair below
# clears the stale mount and then guarantees the directory instead.

[Service]
Type=simple
User=del
Group=del
# Clear a mount left behind by a process that died without unmounting; the
# leading "-" makes the usual case, where there is nothing to clear, a no-op.
ExecStartPre=-/bin/fusermount -uz /home/del/weathermap-charts.saigonweather.online
ExecStartPre=/bin/mkdir -p /home/del/weathermap-charts.saigonweather.online
ExecStart=/usr/local/bin/rclone mount weathermap-r2:weathermap-charts /home/del/weathermap-charts.saigonweather.online \
    --config=/home/del/.config/rclone/rclone.conf \
    --vfs-cache-mode writes \
    --vfs-cache-max-age 24h \
    --dir-cache-time 10s \
    --buffer-size 16M \
    --vfs-write-back 1s \
    --transfers 4 \
    --checkers 4 \
    --umask 002 \
    --uid 1000 \
    --gid 1000 \
    --daemon-timeout 30s
ExecStop=/bin/fusermount -uz /home/del/weathermap-charts.saigonweather.online
TimeoutStartSec=60
TimeoutStopSec=20
KillMode=process
Restart=on-failure
RestartSec=30
StartLimitInterval=300
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
